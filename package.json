{
  "name": "reactive-correction-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "demo": "tsx src/cli/runDemo.ts",
    "demo:compare": "tsx src/cli/runComparison.ts",
    "demo:graph": "tsx src/cli/runDemo.ts --mode graph",
    "demo:ollama": "tsx src/cli/runDemo.ts --provider ollama",
    "demo:report": "tsx src/cli/runReport.ts",
    "demo:web": "tsx src/cli/runWebDemo.ts",
    "evaluate:corroboration": "tsx src/cli/runCorroborationEvaluation.ts",
    "evaluate:ollama": "tsx src/cli/runEvaluation.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify:lockfile": "pnpm install --frozen-lockfile --lockfile-only"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.5",
    "@signal-kernel/async-runtime": "0.3.0",
    "@signal-kernel/core": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}
